// FINANCIAL - TRANSACTIONS (Receitas e Despesas)
// ═══════════════════════════════════════════════════════════════

model Transaction {
  id        String @id @default(cuid())
  companyId String

  // Tipo e Status
  type   TransactionType // INCOME ou EXPENSE
  status TransactionStatus @default(PENDING)

  // Informações Básicas
  description String
  reference   String?

  // Valores
  amount   Decimal
  currency String  @default("BRL")

  // Datas
  transactionDate DateTime
  dueDate         DateTime?
  paidDate        DateTime?

  // Contexto (opcional - pode estar ligado a projeto, cliente, fornecedor)
  projectId  String?
  clientId   String?
  supplierId String?
  employeeId String?

  // Método de Pagamento
  paymentMethod PaymentMethod?
  bankAccountId String?

  // Observações
  notes       String?
  attachments String? // JSON array de URLs

  // Auditoria
  createdBy String?
  updatedBy String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([type])
  @@index([status])
  @@index([transactionDate])
  @@index([dueDate])
  @@map("transactions")
}

// Banking APIs
model BankTransaction {
  id        String @id @default(cuid())
  companyId String

  // Transação Bancária
  bankCode      String
  accountNumber String
  transactionId String // ID externo do banco

  // Valores
  amount   Decimal
  type     String // DEBIT, CREDIT
  currency String  @default("BRL")

  // Informações
  description   String
  counterparty  String? // Outra parte
  referenceCode String?

  // Timestamps
  transactionDate DateTime
  valueDate       DateTime?

  // Sincronização
  syncedAt DateTime?
  source   String    @default("MANUAL") // MANUAL, PIX, BOLETO, TRANSFER, API

  createdAt DateTime @default(now())

  // Relações
  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, transactionId])
  @@index([companyId])
  @@index([transactionDate])
  @@map("bank_transactions")
}

