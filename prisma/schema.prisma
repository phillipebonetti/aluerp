// AluERP — Schema Prisma Profissional
// Banco: PostgreSQL via Supabase
// Multi-tenant: cada empresa é um tenant isolado
// Versão: 3.0.0 (Fundação de Banco de Dados)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════
// CORE — INFRAESTRUTURA MULTIEMPRESA
// ═══════════════════════════════════════════════════════════════

// Empresa (Tenant)
model Company {
  id              String   @id @default(cuid())
  name            String
  cnpj            String?  @unique
  phone           String?
  email           String?
  logo            String?
  website         String?
  timezone        String   @default("America/Sao_Paulo")
  plan            Plan     @default(FREE)
  status          CompanyStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relações
  members         CompanyMember[]
  roles           Role[]
  permissions     Permission[]
  employees       Employee[]
  clients         Client[]
  suppliers       Supplier[]
  projects        Project[]
  quotes          Quote[]
  serviceOrders   ServiceOrder[]
  transactions    Transaction[]
  bankAccounts    BankAccount[]
  costCenters     CostCenter[]
  expenseCategories ExpenseCategory[]
  incomeCategories  IncomeCategory[]
  settings        CompanySetting?
  projectDocuments ProjectDocument[] @relation("ProjectDocumentCompany")
  supplierDocuments SupplierDocument[] @relation("SupplierDocumentCompany")
  projectPhotos    ProjectPhoto[] @relation("ProjectPhotoCompany")
  leads            Lead[]
  opportunities    Opportunity[]
  activities       Activity[]
  reminders        Reminder[]
  crmHistory       CRMHistory[]
  lossReasons      LossReason[]

  @@index([plan])
  @@index([status])
  @@index([deletedAt])
  @@map("companies")
}

// Usuário
model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  avatar          String?
  phone           String?
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relações
  memberships     CompanyMember[]
  auditLogs       AuditLog[]
  crmHistory      CRMHistory[]

  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

// Membro de Empresa (N:N com papel)
model CompanyMember {
  id              String   @id @default(cuid())
  companyId       String
  userId          String
  roleId          String?
  status          MemberStatus @default(ACTIVE)
  joinedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@map("company_members")
}

// Papéis RBAC
model Role {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  description     String?
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members         CompanyMember[]
  permissions     RolePermission[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

// Permissões
model Permission {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  description     String?
  resource        String   // ex: clients, projects, financeiro
  action          String   // ex: create, read, update, delete
  createdAt       DateTime @default(now())

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roles           RolePermission[]

  @@unique([companyId, resource, action])
  @@index([companyId])
  @@map("permissions")
}

// Junction para Role x Permission
model RolePermission {
  id              String   @id @default(cuid())
  roleId          String
  permissionId    String

  // Relações
  role            Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission      Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ═══════════════════════════════════════════════════════════════
// FUNCIONÁRIOS
// ═══════════════════════════════════════════════════════════════

model Employee {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  email           String?
  phone           String?
  role            EmployeeRole @default(OTHER)
  commissionRate  Decimal  @db.Decimal(5, 2) @default(0)
  status          EmployeeStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotes          Quote[]
  transactions    Transaction[]
  leadsResponsible Lead[]
  opportunitiesResponsible Opportunity[]
  activities      Activity[]
  reminders       Reminder[]

  @@index([companyId])
  @@index([status])
  @@index([email])
  @@index([companyId, status])
  @@map("employees")
}

// ═══════════════════════════════════════════════════════════════
// CLIENTES
// ═══════════════════════════════════════════════════════════════

model Client {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  type            ClientType @default(PERSON)
  documentType    DocumentType @default(CPF)
  document        String?
  email           String?
  phone           String?
  status          ClientStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts        ClientContact[]
  addresses       ClientAddress[]
  quotes          Quote[]
  projects        Project[]
  transactions    Transaction[]
  opportunities   Opportunity[]

  @@index([companyId])
  @@index([document])
  @@index([status])
  @@index([deletedAt])
  @@map("clients")
}

model ClientContact {
  id              String   @id @default(cuid())
  clientId        String
  name            String
  email           String?
  phone           String?
  role            String?
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  client          Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contacts")
}

model ClientAddress {
  id              String   @id @default(cuid())
  clientId        String
  street          String
  number          String?
  complement      String?
  neighborhood    String
  city            String
  state           String
  zipCode         String?
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  client          Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_addresses")
}

// ═══════════════════════════════════════════════════════════════
// FORNECEDORES
// ═══════════════════════════════════════════════════════════════

model Supplier {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  type            SupplierType @default(MATERIAL)
  documentType    DocumentType @default(CNPJ)
  document        String?
  email           String?
  phone           String?
  status          SupplierStatus @default(ACTIVE)
  notes           String?
  paymentTerms    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts        SupplierContact[]
  documents       SupplierDocument[]
  transactions    Transaction[]

  @@index([companyId])
  @@index([document])
  @@index([status])
  @@index([type])
  @@map("suppliers")
}

model SupplierContact {
  id              String   @id @default(cuid())
  supplierId      String
  name            String
  email           String?
  phone           String?
  role            String?
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())

  // Relações
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_contacts")
}

model SupplierDocument {
  id              String   @id @default(cuid())
  companyId       String
  supplierId      String
  type            DocumentFileType @default(OTHER)
  fileName        String
  fileSize        Int      // bytes
  mimeType        String?
  version         Int      @default(1)
  isLatest        Boolean  @default(true)
  description     String?
  tags            String?  // JSON array
  uploadedBy      String
  uploadedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relações
  company         Company @relation("SupplierDocumentCompany", fields: [companyId], references: [id], onDelete: Cascade)
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([supplierId])
  @@index([uploadedAt])
  @@map("supplier_documents")
}

// ═══════════════════════════════════════════════════════════════
// OBRAS / PROJETOS
// ═══════════════════════════════════════════════════════════════

model Project {
  id              String   @id @default(cuid())
  companyId       String
  clientId        String
  name            String
  description     String?
  address         String
  status          ProjectStatus @default(PLANNING)
  startDate       DateTime?
  endDate         DateTime?
  totalValue      Decimal? @db.Decimal(12, 2)
  costEstimated   Decimal? @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client          Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  photos          ProjectPhoto[]
  documents       ProjectDocument[]
  costs           ProjectCost[]
  serviceOrders   ServiceOrder[]
  quotes          Quote[]
  transactions    Transaction[]

  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@index([startDate])
  @@map("projects")
}

model ProjectPhoto {
  id              String   @id @default(cuid())
  companyId       String
  projectId       String
  fileName        String
  fileSize        Int      // bytes
  mimeType        String?  // image/jpeg, etc
  caption         String?
  orderIndex      Int      @default(0)
  uploadedBy      String
  uploadedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relações
  company         Company @relation("ProjectPhotoCompany", fields: [companyId], references: [id], onDelete: Cascade)
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@index([uploadedAt])
  @@map("project_photos")
}

model ProjectDocument {
  id              String   @id @default(cuid())
  companyId       String
  projectId       String
  type            DocumentFileType @default(OTHER)
  fileName        String
  fileSize        Int      // bytes
  mimeType        String?
  version         Int      @default(1)
  isLatest        Boolean  @default(true)
  description     String?
  tags            String?  // JSON array
  uploadedBy      String
  uploadedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relações
  company         Company @relation("ProjectDocumentCompany", fields: [companyId], references: [id], onDelete: Cascade)
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions        DocumentVersion[]

  @@unique([projectId, fileName, version])
  @@index([companyId])
  @@index([projectId])
  @@index([uploadedAt])
  @@map("project_documents")
}

// Versionamento de arquivos
model DocumentVersion {
  id              String   @id @default(cuid())
  documentId      String
  version         Int
  url             String
  fileName        String
  fileSize        Int      // bytes
  uploadedBy      String
  uploadedAt      DateTime @default(now())
  description     String?  // O que mudou nesta versão

  // Relações
  document        ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

model ProjectCost {
  id              String   @id @default(cuid())
  projectId       String
  description     String
  amount          Decimal  @db.Decimal(12, 2)
  category        String?
  createdAt       DateTime @default(now())

  // Relações
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_costs")
}

// ═══════════════════════════════════════════════════════════════
// ORÇAMENTOS / COTAÇÕES
// ══════════════════════════════════════════════════��════════════

model Quote {
  id              String   @id @default(cuid())
  companyId       String
  clientId        String
  projectId       String?
  salespersonId   String?
  number          String
  status          QuoteStatus @default(DRAFT)
  totalValue      Decimal  @db.Decimal(12, 2)
  commissionRateApplied Decimal? @db.Decimal(5, 2)
  validUntil      DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  sentAt          DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  deletedAt       DateTime?

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client          Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  salesperson     Employee? @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
  items           QuoteItem[]
  versions        QuoteVersion[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([clientId])
  @@index([projectId])
  @@index([salespersonId])
  @@index([status])
  @@index([createdAt])
  @@index([companyId, projectId])
  @@index([companyId, clientId])
  @@index([companyId, salespersonId])
  @@map("quotes")
}

model QuoteItem {
  id              String   @id @default(cuid())
  quoteId         String
  description     String
  quantity        Decimal  @db.Decimal(10, 3)
  unit            String   @default("un")
  unitPrice       Decimal  @db.Decimal(12, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)
  discount        Decimal? @db.Decimal(12, 2) @default(0)
  order           Int

  // Relações
  quote           Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
}

model QuoteVersion {
  id              String   @id @default(cuid())
  quoteId         String
  versionNumber   Int
  status          QuoteStatus
  totalValue      Decimal  @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime @default(now())

  // Relações
  quote           Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, versionNumber])
  @@index([quoteId])
  @@map("quote_versions")
}

// ═════════════════════════════════════════════════════════��═════
// ORDENS DE SERVIÇO
// ══════════════════════════════════════════════════════════════���

model ServiceOrder {
  id              String   @id @default(cuid())
  companyId       String
  projectId       String
  number          String
  status          ServiceOrderStatus @default(DRAFT)
  scheduledDate   DateTime?
  startDate       DateTime?
  endDate         DateTime?
  description     String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project         Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([companyId, number])
  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@map("service_orders")
}

// ═══════════════════════════════════════════════════════════════
// FINANCEIRO
// ═══════════════════════════════════════════════════════════════

model BankAccount {
  id              String   @id @default(cuid())
  companyId       String
  bankName        String
  accountNumber   String
  accountType     String
  balance         Decimal  @db.Decimal(14, 2) @default(0)
  status          BankAccountStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions    Transaction[]

  @@index([companyId])
  @@map("bank_accounts")
}

model CostCenter {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  description     String?
  status          CostCenterStatus @default(ACTIVE)
  createdAt       DateTime @default(now())

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions    Transaction[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("cost_centers")
}

model ExpenseCategory {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions    Transaction[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("expense_categories")
}

model IncomeCategory {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions    Transaction[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("income_categories")
}

model Transaction {
  id              String   @id @default(cuid())
  companyId       String
  type            TransactionType
  category        String?
  amount          Decimal  @db.Decimal(14, 2)
  description     String
  status          TransactionStatus @default(PENDING)
  paymentMethod   PaymentMethod
  dueDate         DateTime?
  paymentDate     DateTime?
  notes           String?
  supplierId      String?
  clientId        String?
  projectId       String?
  salespersonId   String?
  bankAccountId   String?
  costCenterId    String?
  expenseCategoryId String?
  incomeCategoryId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  client          Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  salesperson     Employee? @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
  bankAccount     BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  costCenter      CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  expenseCategory ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)
  incomeCategory  IncomeCategory? @relation(fields: [incomeCategoryId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([type])
  @@index([status])
  @@index([dueDate])
  @@index([paymentDate])
  @@index([clientId])
  @@index([projectId])
  @@index([salespersonId])
  @@index([companyId, status, dueDate])
  @@index([companyId, type, paymentDate])
  @@index([companyId, clientId])
  @@index([companyId, projectId])
  @@index([companyId, salespersonId])
  @@map("transactions")
}

// ═══════════════════════════════════════════════════════════════
// AUDITORIA
// ═══════════════════════���═══════════════════════════════════════

model AuditLog {
  id              String   @id @default(cuid())
  userId          String
  action          String
  resource        String
  resourceId      String
  changes         String?  // JSON serializado
  ipAddress       String?
  createdAt       DateTime @default(now())

  // Relações
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// Configurações da Empresa
model CompanySetting {
  id              String   @id @default(cuid())
  companyId       String   @unique
  
  // Dados da empresa
  logo            String?  // URL ou base64
  razaoSocial     String?
  cnpj            String?
  
  // Contato
  email           String?
  whatsapp        String?
  
  // Financeiro
  comissaoPercentual Float? @default(5.0)
  impostoPercentual Float? @default(15.0)
  
  // Horários e metas
  horarioAbertura String? @default("09:00")
  horarioFechamento String? @default("18:00")
  metaVendas      Float?
  metaClientes    Float?
  
  // Numeração automática
  proximoNumeroOS         Int @default(1)
  proximoNumeroOrcamento  Int @default(1)
  proximoNumeroNota       Int @default(1)
  
  // Assinaturas e documentos
  assinaturaPadrao String?
  carimboNota      String?
  rodapePadrao     String?
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  @@index([companyId])
  @@map("company_settings")
}

// ═══════════════════════════════════════════════════════════════
// CRM — GESTÃO DE RELACIONAMENTO COM CLIENTES
// ═══════════════════════════════════════════════════════════════

// Lead (Prospect)
model Lead {
  id                String   @id @default(cuid())
  companyId         String
  name              String
  email             String?
  phone             String?
  whatsapp          String?
  cpf               String?
  cnpj              String?
  city              String?
  state             String?
  zipCode           String?
  address           String?
  source            LeadSource @default(OUTRO)
  interests         String?   // JSON array: ["Box", "Portão", "Cobertura", ...]
  estimatedValue    Float?
  responsibleId     String?
  status            LeadStatus @default(NEW)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastContactAt     DateTime?
  notes             String?

  // Relações
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  responsible       Employee? @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  opportunity       Opportunity?
  activities        Activity[]
  history           CRMHistory[]

  @@index([companyId])
  @@index([source])
  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

// Opportunity (Oportunidade)
model Opportunity {
  id                String   @id @default(cuid())
  companyId         String
  leadId            String   @unique
  clientId          String?
  stage             OpportunityStage @default(NEW_LEAD)
  value             Float
  probability       Int      @default(10)
  responsibleId     String?
  lastContactAt     DateTime?
  nextActionDate    DateTime?
  expectedCloseDate DateTime?
  status            OpportunityStatus @default(OPEN)
  lossReasonId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  closedAt          DateTime?

  // Relações
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead              Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client            Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  responsible       Employee? @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  lossReason        LossReason? @relation(fields: [lossReasonId], references: [id], onDelete: SetNull)
  activities        Activity[]
  files             OpportunityFile[]
  history           CRMHistory[]

  @@index([companyId])
  @@index([stage])
  @@index([status])
  @@index([createdAt])
  @@map("opportunities")
}

// Activity (Atividade)
model Activity {
  id                String   @id @default(cuid())
  companyId         String
  leadId            String?
  opportunityId     String?
  type              ActivityType
  title             String
  description       String?
  result            String?
  nextAction        String?
  attachmentUrl     String?
  createdBy         String
  createdAt         DateTime @default(now())
  scheduledFor      DateTime?
  completedAt       DateTime?

  // Relações
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead              Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity       Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  creator           Employee @relation(fields: [createdBy], references: [id])

  @@index([companyId])
  @@index([type])
  @@index([leadId])
  @@index([opportunityId])
  @@index([createdAt])
  @@map("activities")
}

// Reminder (Lembretes)
model Reminder {
  id                String   @id @default(cuid())
  companyId         String
  leadId            String?
  opportunityId     String?
  title             String
  description       String?
  dueDate           DateTime
  priority          ReminderPriority @default(NORMAL)
  isCompleted       Boolean  @default(false)
  assignedTo        String
  createdAt         DateTime @default(now())
  completedAt       DateTime?

  // Relações
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignee          Employee @relation(fields: [assignedTo], references: [id])

  @@index([companyId])
  @@index([dueDate])
  @@index([priority])
  @@map("reminders")
}

// CRM History (Histórico de alterações)
model CRMHistory {
  id                String   @id @default(cuid())
  companyId         String
  leadId            String?
  opportunityId     String?
  action            String
  description       String
  oldValue          String?
  newValue          String?
  userId            String
  createdAt         DateTime @default(now())

  // Relações
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead              Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity       Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user              User @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([createdAt])
  @@map("crm_history")
}

// Files de Oportunidade
model OpportunityFile {
  id                String   @id @default(cuid())
  opportunityId     String
  fileName          String
  fileUrl           String
  fileSize          Int
  mimeType          String
  fileType          String    // "quote", "contract", "proposal", etc.
  uploadedBy        String
  createdAt         DateTime @default(now())

  // Relações
  opportunity       Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@map("opportunity_files")
}

// Loss Reason (Motivos de perda)
model LossReason {
  id                String   @id @default(cuid())
  companyId         String
  name              String
  description       String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  // Relações
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunities     Opportunity[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("loss_reasons")
}

