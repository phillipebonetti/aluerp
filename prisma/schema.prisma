  ACCOUNTS_PAYABLE
  ACCOUNTS_RECEIVABLE
  PIX_TRANSACTIONS
  ATTACHMENTS
  USERS
  PERMISSIONS
  SETTINGS
  INTEGRATIONS
  REPORTS
  AUTH
}

model AuditLog {
  id        String @id @default(cuid())
  companyId String

  // Usuário que executou
  userId    String
  userName  String
  userEmail String
  userRole  String?

  // Ação e contexto
  module AuditModule
  action AuditAction

  // Entidade afetada
  entity     String // Cliente, Fornecedor, Obra, OS, Orçamento, etc
  entityId   String
  entityName String? // Nome para referência rápida

  // Dados antes e depois
  oldData       String? // JSON da entidade antes da mudança
  newData       String? // JSON da entidade após a mudança
  changedFields String? // JSON array com campos alterados

  // Contexto da requisição
  ipAddress String?
  userAgent String? // Browser, device info

  // Descrição legível
  description String?

  // Status
  success      Boolean @default(true)
  errorMessage String?

  // Timestamp
  createdAt DateTime @default(now())

  // Relações
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@index([companyId, entity, entityId])
  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// Configuração de Retenção de Logs de Auditoria
model AuditRetentionPolicy {
  id        String @id @default(cuid())
  companyId String @unique

  // Política de retenção
  retentionDays Int       @default(365) // 90, 180, 365, -1 (nunca)
  autoDelete    Boolean   @default(true)
  lastCleanupAt DateTime?

  // Notificações
  notifyDaysBeforeDelete Int @default(7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  companies Company[]

  @@map("audit_retention_policies")
}

// ═══════════════════════════════════════════════════════════════
// BACKUP E RESTAURAÇÃO
// ════════════════════════════════════��══════════════════════════

enum BackupFrequency {
  MANUAL
  DAILY
  WEEKLY
  MONTHLY
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  ARCHIVED
}

model BackupConfiguration {
  id        String @id @default(cuid())
  companyId String @unique

  // Agendamento
  frequency     BackupFrequency @default(DAILY)
  scheduledHour Int             @default(2) // 0-23
  scheduledDay  Int?            @default(1) // Para WEEKLY (0-6) e MONTHLY (1-31)

  // Configurações
  retainBackups Int     @default(30) // Manter últimos N backups
  autoDelete    Boolean @default(true)

  // Notificações
  notifyEmail     String?
  notifyOnFailure Boolean @default(true)

  // Controle
  isEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  companies Company[]

  @@map("backup_configurations")
}

model Backup {
  id        String @id @default(cuid())
  companyId String

  // Informações
  name        String
  description String?

  // Status
  status BackupStatus @default(PENDING)

  // Dados do backup
  size     BigInt? // Tamanho em bytes
  fileName String? // Nome do arquivo armazenado
  fileUrl  String? // URL para download (se armazenado em cloud)

  // Conteúdo
  includesDatabase    Boolean @default(true)
  includesUploads     Boolean @default(true)
  includesPDFs        Boolean @default(true)
  includesLogos       Boolean @default(true)
  includesAttachments Boolean @default(true)
  includesXML         Boolean @default(true)

  // Tipo
  type String @default("MANUAL") // MANUAL, AUTOMATIC, SCHEDULED

  // Quem criou
  createdBy     String
  createdByName String?

  // Timestamps
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  // Restauração
  lastRestoredAt DateTime?
  lastRestoredBy String?

  // Metadados
  metadata     String? // JSON com info do backup
  errorMessage String?

  // Relações
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([status])
  @@index([createdAt])
  @@index([type])
  @@map("backups")
}

model BackupLog {
  id        String  @id @default(cuid())
  companyId String
  backupId  String?

  // Ação
  action String // BACKUP_STARTED, BACKUP_COMPLETED, RESTORE_STARTED, RESTORE_COMPLETED

  // Usuário
  userId   String
  userName String?

  // Detalhes
  details      String? // JSON com detalhes da operação
  errorMessage String?
  success      Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())

  // Relações
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([backupId])
  @@index([createdAt])
  @@map("backup_logs")
}

