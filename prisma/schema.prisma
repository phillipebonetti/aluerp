model ReportSchedule {
  id            String     @id @default(cuid())
  companyId     String
  name          String
  type          ReportType @default(FINANCIAL)
  frequency     String     @default("MONTHLY") // DAILY, WEEKLY, MONTHLY
  time          String     @default("09:00") // HH:mm format
  dayOfWeek     Int? // 0-6 (0=Sunday)
  dayOfMonth    Int? // 1-31
  recipients    String // JSON array de emails
  format        String     @default("PDF") // PDF, EXCEL, CSV
  filters       String? // JSON com filtros
  lastSent      DateTime?
  nextScheduled DateTime?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relações
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([isActive])
  @@map("report_schedules")
}

model DashboardLayout {
  id          String   @id @default(cuid())
