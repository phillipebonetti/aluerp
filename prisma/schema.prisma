enum IntegrationProvider {
  WHATSAPP
  EMAIL
  GOOGLE_CALENDAR
  GOOGLE_DRIVE
  CONTA_AZUL
  PIX_BANKING
  BOLETO_BANKING
  ZAPIER
  MAKE
  CUSTOM
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING
  EXPIRED
}

enum IntegrationLogLevel {
  INFO
  WARNING
  ERROR
  DEBUG
}

model Integration {
  id          String              @id @default(cuid())
  companyId   String
  provider    IntegrationProvider
  name        String
  description String?
  status      IntegrationStatus   @default(DISCONNECTED)

  // Credenciais (criptografadas)
  credentials String? // JSON criptografado

  // Configurações
  config String? // JSON com settings customizados

  // Sincronização
  lastSync      DateTime?
  lastError     String?
  syncFrequency String?   @default("HOURLY") // MANUAL, HOURLY, DAILY, WEEKLY

  // Controle
  isActive   Boolean   @default(false)
  enabledAt  DateTime?
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relações
  logs     IntegrationLog[]
  webhooks Webhook[]
  company  Company          @relation(fields: [companyId], references: [id])

  @@unique([companyId, provider])
  @@index([companyId])
  @@index([provider])
  @@index([status])
  @@map("integrations")
}

model IntegrationLog {
  id            String              @id @default(cuid())
  integrationId String
  level         IntegrationLogLevel @default(INFO)

  // Request
  endpoint    String?
  method      String? @default("GET")
  requestData String? // JSON

  // Response
  statusCode   Int?
  responseData String? // JSON
  errorMessage String?

  // Performance
  duration Int? // milliseconds

  // Metadados
  metadata String? // JSON livre

  createdAt DateTime @default(now())

  // Relações
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([createdAt])
  @@index([level])
  @@map("integration_logs")
}

model Webhook {
  id            String @id @default(cuid())
  companyId     String
  integrationId String

  // URL e Eventos
  url    String
  events String // JSON array de eventos
  secret String? // Token para validação

  // Status e Controle
  isActive      Boolean   @default(true)
  lastTriggered DateTime?
  failureCount  Int       @default(0)
  maxRetries    Int       @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  integration Integration       @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]
  company     Company           @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([integrationId])
  @@index([isActive])
  @@map("webhooks")
}

model WebhookDelivery {
  id        String @id @default(cuid())
  webhookId String

  // Evento disparado
  event   String
  payload String // JSON

  // Resultado
  statusCode   Int?
  responseBody String?
  success      Boolean @default(false)

  // Retry
  attempt     Int       @default(1)
  nextRetryAt DateTime?

  createdAt DateTime @default(now())

  // Relações
  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([event])
  @@index([success])
  @@map("webhook_deliveries")
}

model ApiToken {
  id        String @id @default(cuid())
  companyId String
  userId    String

  // Token
