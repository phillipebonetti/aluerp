// AluERP — Schema Prisma Profissional
// Banco: PostgreSQL via Supabase
// Multi-tenant: cada empresa é um tenant isolado
// Versão: 3.0.0 (Fundação de Banco de Dados)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════
// CORE — INFRAESTRUTURA MULTIEMPRESA
// ═══════════════════════════════════════════════════════════════

// Empresa (Tenant)
model Company {
  id        String        @id @default(cuid())
  name      String
  cnpj      String?       @unique
  phone     String?
  email     String?
  logo      String?
  website   String?
  timezone  String        @default("America/Sao_Paulo")
  plan      Plan          @default(FREE)
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  // Relações
  roles                  Role[]
  permissions            Permission[]
  employees              Employee[]
  clients                Client[]
  suppliers              Supplier[]
  projects               Project[]
  quotes                 Quote[]
  postSales              PostSale[]
  reportSchedules        ReportSchedule[]
  dashboardLayouts       DashboardLayout[]
  reportTemplates        ReportTemplate[]
  reportExports          ReportExport[]
  integrations           Integration[]
  webhooks               Webhook[]
  apiTokens              ApiToken[]
  whatsappMessages       WhatsAppMessage[]
  emailMessages          EmailMessage[]
  calendarEvents         CalendarEvent[]
  storageFiles           StorageFile[]
  transactions           Transaction[]
  bankTransactions       BankTransaction[]
  aiConversations        AIConversation[]
  aiPrompts              AIPredefinedPrompt[]
  aiInsights             AIInsight[]
  aiPredictions          AIPrediction[]
  aiDocuments            AIGeneratedDocument[]
  aiProviderConfig       AIProviderConfig?     @relation(fields: [aIProviderConfigId], references: [id])
  aiUsageLogs            AIUsageLog[]
  auditLogs              AuditLog[]
  auditRetentionPolicy   AuditRetentionPolicy? @relation(fields: [auditRetentionPolicyId], references: [id])
  backupConfig           BackupConfiguration?  @relation(fields: [backupConfigurationId], references: [id])
  backups                Backup[]
  backupLogs             BackupLog[]
  notifications          Notification[]
  warranties             Warranty[]
  supportTickets         SupportTicket[]
  productionOrders       ProductionOrder[]
  products               Product[]
  inventoryMovements     InventoryMovement[]
  purchaseRequests       PurchaseRequest[]
  commercialTasks        CommercialTask[]
  leads                  Lead[]
  installationEvents     InstallationEvent[]
  clientChats            ClientChat[]
  clientFeedback         ClientFeedback[]
  aIProviderConfigId     String?
  auditRetentionPolicyId String?
  backupConfigurationId  String?
  serviceOrders          ServiceOrder[]
  commissionRules        CommissionRule[] // GO LIVE 2
  commissionPayments     CommissionPayment[] // GO LIVE 2
  commissionHistories    CommissionHistory[] // GO LIVE 2
  financialAccounts      FinancialAccount[] // GO LIVE 3
  expenseCategories      ExpenseCategory[] // GO LIVE 3
  costCenters            CostCenter[] // GO LIVE 3
  cashMovements          CashMovement[] // GO LIVE 3
  financialForecasts     FinancialForecast[] // GO LIVE 3
  financialAlerts        FinancialAlert[] // GO LIVE 3

  @@index([plan])
  @@index([status])
}

// Papéis RBAC
model Role {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relações
  permissions RolePermission[]
  company     Company          @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

// Permissões
model Permission {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  resource    String // ex: clients, projects, financeiro
  action      String // ex: create, read, update, delete
  createdAt   DateTime @default(now())

  // Relações
  roles   RolePermission[]
  company Company          @relation(fields: [companyId], references: [id])

  @@unique([companyId, resource, action])
  @@index([companyId])
  @@map("permissions")
}

// Junction para Role x Permission
model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  // Relações
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ═══════════════════════════════════════════════════════════════
// FUNCIONÁRIOS
// ═══════════════════════════════════════════════════════════════

model Employee {
  id             String         @id @default(cuid())
  companyId      String
  name           String
  email          String?
  phone          String?
  cpf            String? // GO LIVE 2: CPF do vendedor
  role           EmployeeRole   @default(OTHER)
  commissionRate Decimal        @default(0) @db.Decimal(5, 2)
  status         EmployeeStatus @default(ACTIVE)
  hireDate       DateTime? // GO LIVE 2: Data de admissão
  notes          String? // GO LIVE 2: Observações
  isSalesperson  Boolean        @default(false) // GO LIVE 2: Flag para vendedor
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  // Relações
  quotes                   Quote[]
  leadsResponsible         Lead[]
  opportunitiesResponsible Opportunity[]
  activities               Activity[]
  reminders                Reminder[]
  responsibleStages        WorkStage[]
  responsibleTasks         WorkTask[]
  workTeams                WorkTeam[]
  salesGoals               SalesGoal[]
  serviceOrders            ServiceOrder[]      @relation("ServiceOrderVendedor")
  osInstallations          OSInstallation[]
  osCommissions            OSCommission[]
  commissionPayments       CommissionPayment[] // GO LIVE 2
  commissionRules          CommissionRule[] // GO LIVE 2
  commissionHistories      CommissionHistory[] // GO LIVE 2
  company                  Company             @relation(fields: [companyId], references: [id])
  osproductionStages       OSProductionStage[]
  oscomments               OSComment[]

  @@index([companyId])
  @@index([status])
  @@index([email])
  @@index([isSalesperson])
  @@index([companyId, status])
  @@index([companyId, isSalesperson])
  @@map("employees")
}

// ═══════════════════════════════════════════════════════════════
// CLIENTES
// ═══════════════════════════════════════════════════════════════

model Client {
  id           String       @id @default(cuid())
  companyId    String
  name         String
  type         ClientType   @default(PERSON)
  documentType DocumentType @default(CPF)
  document     String?
  email        String?
  phone        String?
  status       ClientStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  // Relações
  contacts      ClientContact[]
  addresses     ClientAddress[]
  quotes        Quote[]
  projects      Project[]
  opportunities Opportunity[]
  serviceOrders ServiceOrder[]
  company       Company         @relation(fields: [companyId], references: [id])
  postSales     PostSale[]

  @@index([companyId])
  @@index([document])
  @@index([status])
  @@index([deletedAt])
  @@map("clients")
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  email     String?
  phone     String?
  role      String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contacts")
}

model ClientAddress {
  id           String   @id @default(cuid())
  clientId     String
  street       String
  number       String?
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relações
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_addresses")
}

// ═══════════════════════════════════════════════════════════════
// FORNECEDORES
// ═══════════════════════��════════════════════════════════��══════

model Supplier {
  id           String         @id @default(cuid())
  companyId    String
  name         String
  type         SupplierType   @default(MATERIAL)
  documentType DocumentType   @default(CNPJ)
  document     String?
  email        String?
  phone        String?
  status       SupplierStatus @default(ACTIVE)
  notes        String?
  paymentTerms String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  // Relações
  contacts  SupplierContact[]
  documents SupplierDocument[]
  company   Company            @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([document])
  @@index([status])
  @@index([type])
  @@map("suppliers")
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  name       String
  email      String?
  phone      String?
  role       String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  // Relações
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_contacts")
}

model SupplierDocument {
  id          String           @id @default(cuid())
  companyId   String
  supplierId  String
  type        DocumentFileType @default(OTHER)
  fileName    String
  fileSize    Int // bytes
  mimeType    String?
  version     Int              @default(1)
  isLatest    Boolean          @default(true)
  description String?
  tags        String? // JSON array
  uploadedBy  String
  uploadedAt  DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  // Relações
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([supplierId])
  @@index([uploadedAt])
  @@map("supplier_documents")
}

// ═══════════════════════════════════════════════════════════════
// OBRAS / PROJETOS
// ═══════════════════════════════════════════════════════════════

model Project {
  id            String        @id @default(cuid())
  companyId     String
  clientId      String
  name          String
  description   String?
  address       String
  status        ProjectStatus @default(PLANNING)
  startDate     DateTime?
  endDate       DateTime?
  totalValue    Decimal?      @db.Decimal(12, 2)
  costEstimated Decimal?      @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  // Relações
  client        Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  photos        ProjectPhoto[]
  documents     ProjectDocument[]
  costs         ProjectCost[]
  serviceOrders ServiceOrder[]
  quotes        Quote[]
  stages        WorkStage[]
  tasks         WorkTask[]        @relation("WorkTasks")
  checklists    TaskChecklist[]   @relation("TaskChecklists")
  measurements  WorkMeasurement[] @relation("WorkMeasurements")
  team          WorkTeam[]        @relation("WorkTeam")
  occurrences   WorkOccurrence[]  @relation("WorkOccurrences")
  diaries       WorkDiary[]       @relation("WorkDiary")
  comments      WorkComment[]     @relation("WorkComments")
  attachments   WorkAttachment[]  @relation("WorkAttachments")
  postSale      PostSale?
  company       Company           @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@index([startDate])
  @@map("projects")
}

model ProjectPhoto {
  id         String    @id @default(cuid())
  companyId  String
  projectId  String
  fileName   String
  fileSize   Int // bytes
  mimeType   String? // image/jpeg, etc
  caption    String?
  orderIndex Int       @default(0)
  uploadedBy String
  uploadedAt DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  // Relações
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@index([uploadedAt])
  @@map("project_photos")
}

model ProjectDocument {
  id          String           @id @default(cuid())
  companyId   String
  projectId   String
  type        DocumentFileType @default(OTHER)
  fileName    String
  fileSize    Int // bytes
  mimeType    String?
  version     Int              @default(1)
  isLatest    Boolean          @default(true)
  description String?
  tags        String? // JSON array
  uploadedBy  String
  uploadedAt  DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  // Relações
  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions DocumentVersion[]

  @@unique([projectId, fileName, version])
  @@index([companyId])
  @@index([projectId])
  @@index([uploadedAt])
  @@map("project_documents")
}

// Versionamento de arquivos
model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  version     Int
  url         String
  fileName    String
  fileSize    Int // bytes
  uploadedBy  String
  uploadedAt  DateTime @default(now())
  description String? // O que mudou nesta versão

  // Relações
  document ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

model ProjectCost {
  id          String   @id @default(cuid())
  projectId   String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  category    String?
  createdAt   DateTime @default(now())

  // Relações
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_costs")
}

// ═════════════════════════════════════���═════════════════════════
// GESTÃO DE OBRAS — ETAPAS, TAREFAS, CHECKLISTS
// ══════════════════════════════════════��════════════════════════

model WorkStage {
  id               String          @id @default(cuid())
  projectId        String
  companyId        String
  name             String
  position         Int             @default(0)
  status           WorkStageStatus @default(PENDING)
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  responsibleId    String?
  description      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relações
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsible Employee?  @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  tasks       WorkTask[]

  @@unique([projectId, position])
  @@index([projectId])
  @@index([companyId])
  @@index([status])
  @@map("work_stages")
}

model WorkTask {
  id             String         @id @default(cuid())
  projectId      String
  stageId        String
  companyId      String
  title          String
  description    String?
  status         WorkTaskStatus @default(TODO)
  priority       TaskPriority   @default(NORMAL)
  responsibleId  String?
  dueDate        DateTime?
  startDate      DateTime?
  completedDate  DateTime?
  estimatedHours Int?
  actualHours    Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relações
  project     Project          @relation("WorkTasks", fields: [projectId], references: [id], onDelete: Cascade)
  stage       WorkStage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  responsible Employee?        @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  checklists  TaskChecklist[]
  comments    WorkComment[]
  attachments WorkAttachment[]

  @@index([projectId])
  @@index([stageId])
  @@index([companyId])
  @@index([status])
  @@index([dueDate])
  @@map("work_tasks")
}

model TaskChecklist {
  id          String    @id @default(cuid())
  taskId      String
  projectId   String
  companyId   String
  title       String
  isCompleted Boolean   @default(false)
  completedBy String?
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relações
  task    WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project  @relation("TaskChecklists", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([projectId])
  @@index([companyId])
  @@map("task_checklists")
}

model WorkMeasurement {
  id          String   @id @default(cuid())
  projectId   String
  companyId   String
  environment String? // Cômodo, local
  height      Decimal? @db.Decimal(8, 2)
  width       Decimal? @db.Decimal(8, 2)
  depth       Decimal? @db.Decimal(8, 2)
  quantity    Int      @default(1)
  unit        String? // m², m, px
  notes       String?
  photoUrl    String?
  sketchUrl   String?
  recordedBy  String
  recordedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relações
  project Project @relation("WorkMeasurements", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([companyId])
  @@map("work_measurements")
}

model WorkTeam {
  id          String           @id @default(cuid())
  projectId   String
  employeeId  String
  companyId   String
  role        String? // Chefe de Obra, Vidraceiro, etc.
  status      TeamMemberStatus @default(ASSIGNED)
  startDate   DateTime         @default(now())
  endDate     DateTime?
  workedHours Int              @default(0)
  addedBy     String
  addedAt     DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relações
  project  Project  @relation("WorkTeam", fields: [projectId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([projectId, employeeId])
  @@index([projectId])
  @@index([employeeId])
  @@index([companyId])
  @@map("work_teams")
}

model WorkOccurrence {
  id          String             @id @default(cuid())
  projectId   String
  companyId   String
  type        OccurrenceType     @default(OTHER)
  title       String
  description String?
  priority    OccurrencePriority @default(NORMAL)
  status      OccurrenceStatus   @default(OPEN)
  reportedBy  String
  reportedAt  DateTime           @default(now())
  resolvedBy  String?
  resolvedAt  DateTime?
  photoUrl    String?
  updatedAt   DateTime           @updatedAt

  // Relações
  project Project @relation("WorkOccurrences", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([companyId])
  @@index([status])
  @@index([priority])
  @@map("work_occurrences")
}

model WorkDiary {
  id            String   @id @default(cuid())
  projectId     String
  companyId     String
  date          DateTime @default(now())
  author        String
  description   String
  weather       String? // Ensolarado, Chuvoso, etc.
  weather_temp  Int? // Temperatura em Celsius
  teamPresent   String? // JSON array de IDs
  materialsUsed String? // JSON array
  photoUrl      String?
  videoUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relações
  project Project @relation("WorkDiary", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([companyId])
  @@index([date])
  @@map("work_diaries")
}

model WorkComment {
  id        String   @id @default(cuid())
  taskId    String?
  projectId String
  companyId String
  author    String
  content   String
  mentions  String? // JSON array de user IDs
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  task    WorkTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project Project   @relation("WorkComments", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([projectId])
  @@index([companyId])
  @@map("work_comments")
}

model WorkAttachment {
  id          String   @id @default(cuid())
  taskId      String?
  projectId   String
  companyId   String
  fileName    String
  fileSize    Int
  mimeType    String?
  fileUrl     String
  uploadedBy  String
  uploadedAt  DateTime @default(now())
  description String?

  // Relações
  task    WorkTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project Project   @relation("WorkAttachments", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([projectId])
  @@index([companyId])
  @@map("work_attachments")
}

// ═══════════════════════════���═══════════════════════════════════
// ORÇAMENTOS / COTAÇÕES
// ════════════════════════════════════════════���═══════════��══════
// ORÇAMENTOS / COTAÇÕES
// ════════════════���══════════════��═══════��══════════��════════════

model Quote {
  id                    String      @id @default(cuid())
  companyId             String
  clientId              String
  projectId             String?
  salespersonId         String?
  number                String
  status                QuoteStatus @default(DRAFT)
  totalValue            Decimal     @db.Decimal(12, 2)
  commissionRateApplied Decimal?    @db.Decimal(5, 2)
  validUntil            DateTime?
  notes                 String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  sentAt                DateTime?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  deletedAt             DateTime?

  // Relações
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  salesperson   Employee?      @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
  items         QuoteItem[]
  versions      QuoteVersion[]
  serviceOrders ServiceOrder[]
  company       Company        @relation(fields: [companyId], references: [id])

  @@unique([companyId, number])
  @@index([companyId])
  @@index([clientId])
  @@index([projectId])
  @@index([salespersonId])
  @@index([status])
  @@index([createdAt])
  @@index([companyId, projectId])
  @@index([companyId, clientId])
  @@index([companyId, salespersonId])
  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  description String
  quantity    Decimal  @db.Decimal(10, 3)
  unit        String   @default("un")
  unitPrice   Decimal  @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
  discount    Decimal? @default(0) @db.Decimal(12, 2)
  order       Int

  // Relações
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
}

model QuoteVersion {
  id            String      @id @default(cuid())
  quoteId       String
  versionNumber Int
  status        QuoteStatus
  totalValue    Decimal     @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime    @default(now())

  // Relações
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, versionNumber])
  @@index([quoteId])
  @@map("quote_versions")
}

// ════════════���════════════════════════════════════════════��═════
// ORDENS DE SERVIÇO
// ══════════════════════════════════════════════════════════════���

model ServiceOrder {
  id            String             @id @default(cuid())
  companyId     String
  projectId     String
  quoteId       String? // Referência ao orçamento que originou esta OS
  clientId      String
  vendedorId    String? // Vendedor responsável
  number        String
  status        ServiceOrderStatus @default(DRAFT)
  priority      String?            @default("NORMAL") // BAIXA, NORMAL, ALTA, URGENTE
  scheduledDate DateTime?
  startDate     DateTime?
  endDate       DateTime?
  actualEndDate DateTime? // Data de conclusão real
  description   String?
  notes         String?

  // Financeiro
  totalValue   Decimal @default(0) @db.Decimal(15, 2)
  downPayment  Decimal @default(0) @db.Decimal(15, 2) // Entrada
  balance      Decimal @default(0) @db.Decimal(15, 2) // Saldo
  installments Int     @default(1) // Número de parcelas

  // Auditoria
  createdBy String?
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relações
  company          Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  quote            Quote?              @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  client           Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vendedor         Employee?           @relation("ServiceOrderVendedor", fields: [vendedorId], references: [id], onDelete: SetNull)
  products         OSProduct[]
  productionStages OSProductionStage[]
  installations    OSInstallation[]
  comments         OSComment[]
  attachments      OSAttachment[]
  materials        OSMaterial[]
  commissions      OSCommission[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([projectId])
  @@index([clientId])
  @@index([quoteId])
  @@index([vendedorId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("service_orders")
}

// ═══════════════════════════════════════════════════════════════
// ORDEM DE SERVIÇO — MODELOS AUXILIARES
// ═══════════════════════════════════════════════════════════════

// Produtos/Itens da Ordem de Serviço
model OSProduct {
  id             String   @id @default(cuid())
  serviceOrderId String
  sequence       Int // Ordem de exibição
  description    String
  quantity       Decimal  @db.Decimal(10, 2)
  width          Decimal? @db.Decimal(10, 2)
  height         Decimal? @db.Decimal(10, 2)
  area           Decimal? @db.Decimal(15, 2) // Calculated: width * height
  unitValue      Decimal  @db.Decimal(12, 2)
  totalValue     Decimal  @db.Decimal(15, 2) // Calculated: quantity * unitValue
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relações
  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@map("os_products")
}

// Estágios de Produção da OS
model OSProductionStage {
  id             String    @id @default(cuid())
  serviceOrderId String
  sequence       Int // Ordem de execução
  name           String // Ex: Corte, Dobra, Soldagem, Pintura
  status         String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, BLOCKED
  responsibleId  String? // Funcionário responsável
  startDate      DateTime?
  endDate        DateTime?
  actualEndDate  DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relações
  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  responsible  Employee?    @relation(fields: [responsibleId], references: [id], onDelete: SetNull)

  @@index([serviceOrderId])
  @@index([responsibleId])
  @@index([status])
  @@map("os_production_stages")
}

// Instalação da OS
model OSInstallation {
  id             String    @id @default(cuid())
  serviceOrderId String
  sequence       Int       @default(1)
  teamLeadId     String? // Líder da equipe de instalação
  scheduledDate  DateTime?
  startDate      DateTime?
  endDate        DateTime?
  actualEndDate  DateTime?
  address        String? // Endereço da instalação (pode ser diferente do cliente)
  city           String?
  state          String?
  postalCode     String?
  contactName    String?
  contactPhone   String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relações
  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  teamLead     Employee?    @relation(fields: [teamLeadId], references: [id], onDelete: SetNull)

  @@index([serviceOrderId])
  @@index([teamLeadId])
  @@map("os_installations")
}

// Comentários/Timeline da OS
model OSComment {
  id             String   @id @default(cuid())
  serviceOrderId String
  authorId       String // Funcionário que comentou
  type           String   @default("COMMENT") // COMMENT, STATUS_CHANGE, NOTE, ATTACHMENT_ADDED
  content        String // Texto do comentário
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relações
  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  author       Employee     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([serviceOrderId])
  @@index([authorId])
  @@index([createdAt])
  @@map("os_comments")
}

// Anexos da OS
model OSAttachment {
  id             String   @id @default(cuid())
  serviceOrderId String
  fileName       String
  fileUrl        String // URL do arquivo armazenado
  fileType       String? // MIME type
  fileSize       Int? // em bytes
  uploadedBy     String // Funcionário que fez upload
  category       String? // Ex: PHOTO, DOCUMENT, DRAWING, VIDEO
  createdAt      DateTime @default(now())

  // Relações
  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@index([uploadedBy])
  @@index([category])
  @@map("os_attachments")
}

// ═══════════════════════════════════════════════════════════════
// ORDEM DE SERVIÇO — GO LIVE 1B - MATERIAIS E COMISSÃO
// ═══════════════════════════════════════════════════════════════

// Materiais necessários para a OS
model OSMaterial {
  id             String    @id @default(cuid())
  serviceOrderId String
  sequence       Int // Ordem de exibição
  name           String // Ex: Alumínio 40x40, Vidro Verde 5mm
  category       String // ALUMINIO, VIDRO, FERRAGENS, ACESSORIOS, OUTROS
  description    String?
  quantity       Decimal   @db.Decimal(10, 2)
  unit           String?   @default("un") // un, m, m2, kg, etc
  unitCost       Decimal   @db.Decimal(12, 2)
  totalCost      Decimal   @db.Decimal(15, 2) // Calculated: quantity * unitCost
  supplier       String? // Fornecedor
  status         String    @default("PENDING") // PENDING, PURCHASED, RECEIVED, PARTIAL, CANCELLED
  purchaseDate   DateTime?
  receivedDate   DateTime?
  receivedQty    Decimal?  @db.Decimal(10, 2) // Quantidade recebida
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relações
  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@index([status])
  @@index([category])
  @@map("os_materials")
}

// Comissão por vendedor
model OSCommission {
  id              String    @id @default(cuid())
  serviceOrderId  String
  vendedorId      String
  osValue         Decimal   @db.Decimal(15, 2) // Valor da OS
  commissionRate  Float     @default(5.0) // Percentual (ex: 5.0 = 5%)
  commissionValue Decimal   @db.Decimal(15, 2) // Calculated: osValue * (commissionRate / 100)
  status          String    @default("PENDING") // PENDING, APPROVED, PAID, CANCELLED
  approvedBy      String?
  approvedAt      DateTime?
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relações
  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  vendedor     Employee     @relation(fields: [vendedorId], references: [id], onDelete: Restrict)

  @@unique([serviceOrderId, vendedorId])
  @@index([serviceOrderId])
  @@index([vendedorId])
  @@index([status])
  @@map("os_commissions")
}

// ═══════════════════════════════════════════════════════════════
// GO LIVE 2 — GERENCIAMENTO DE COMISSÕES E PAGAMENTOS
// ═══════════════════════════════════════════════════════════════

// Regras de Comissão personalizadas por vendedor
model CommissionRule {
  id          String  @id @default(cuid())
  companyId   String
  employeeId  String
  name        String // Ex: "Comissão Padrão", "Comissão Premium"
  description String?

  // Tipos de regra
  ruleType       String   @default("PERCENTAGE") // PERCENTAGE, FIXED, TIERED
  basePercentage Decimal  @db.Decimal(5, 2) // Percentual base
  minValue       Decimal? @db.Decimal(15, 2) // Valor mínimo para aplicar
  maxValue       Decimal? @db.Decimal(15, 2) // Valor máximo

  // Tier progressivo (para ruleType = TIERED)
  tier1Percentage Decimal? @db.Decimal(5, 2)
  tier1UpTo       Decimal? @db.Decimal(15, 2)
  tier2Percentage Decimal? @db.Decimal(5, 2)
  tier2UpTo       Decimal? @db.Decimal(15, 2)
  tier3Percentage Decimal? @db.Decimal(5, 2)

  isActive   Boolean   @default(true)
  validFrom  DateTime?
  validUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relações
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@index([isActive])
  @@map("commission_rules")
}

// Pagamento de Comissão
model CommissionPayment {
  id         String @id @default(cuid())
  companyId  String
  employeeId String

  // Período
  referenceMonth Int // Mês de referência (1-12)
  referenceYear  Int // Ano de referência

  // Valores
  totalCommission    Decimal @db.Decimal(15, 2) // Total de comissões no mês
  approvedCommission Decimal @db.Decimal(15, 2) // Comissão aprovada para pagamento
  paidAmount         Decimal @db.Decimal(15, 2) // Valor efetivamente pago

  // Status
  status           String    @default("PENDING") // PENDING, APPROVED, PAID, CANCELLED
  approvedBy       String? // Usuário que aprovou
  approvedAt       DateTime?
  paidAt           DateTime?
  paidVia          String? // PIX, TRANSFERENCIA, CHEQUE, etc
  paymentReference String? // Número de documento/comprovante

  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relações
  employee  Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  histories CommissionHistory[]

  @@unique([companyId, employeeId, referenceYear, referenceMonth])
  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@index([referenceYear, referenceMonth])
  @@map("commission_payments")
}

// Histórico/Auditoria de Comissões
model CommissionHistory {
  id                  String  @id @default(cuid())
  companyId           String
  commissionPaymentId String?
  employeeId          String
  osCommissionId      String?

  // Tipo de evento
  eventType   String // CREATED, CALCULATED, APPROVED, RELEASED, PAID, REVERSED, CANCELLED
  description String

  // Valores anteriores/atuais
  previousValue Decimal? @db.Decimal(15, 2)
  newValue      Decimal? @db.Decimal(15, 2)

  // Auditoria
  createdBy String? // Usuário que realizou ação
  metadata  String? // JSON com dados adicionais
  createdAt DateTime @default(now())

  // Relações
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  commissionPayment CommissionPayment? @relation(fields: [commissionPaymentId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([employeeId])
  @@index([eventType])
  @@index([createdAt])
  @@map("commission_histories")
}

// Configurações da Empresa
model CompanySetting {
  id        String @id @default(cuid())
  companyId String @unique

  // Dados da empresa
  logo        String? // URL ou base64
  razaoSocial String?
  cnpj        String?

  // Contato
  email    String?
  whatsapp String?

  // Financeiro
  comissaoPercentual Float? @default(5.0)
  impostoPercentual  Float? @default(15.0)

  // Horários e metas
  horarioAbertura   String? @default("09:00")
  horarioFechamento String? @default("18:00")
  metaVendas        Float?
  metaClientes      Float?

  // Numeração automática
  proximoNumeroOS        Int @default(1)
  proximoNumeroOrcamento Int @default(1)
  proximoNumeroNota      Int @default(1)

  // Assinaturas e documentos
  assinaturaPadrao String?
  carimboNota      String?
  rodapePadrao     String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações

  @@index([companyId])
  @@map("company_settings")
}

// ═══════════════════════════════════════════════════════════════
// CRM — GESTÃO DE RELACIONAMENTO COM CLIENTES
// ═════════���═══════════════════════════════════════════════��═════

// Lead (Prospect)
model Lead {
  id             String     @id @default(cuid())
  companyId      String
  name           String
  email          String?
  phone          String?
  whatsapp       String?
  cpf            String?
  cnpj           String?
  city           String?
  state          String?
  zipCode        String?
  address        String?
  source         LeadSource @default(OUTRO)
  interests      String? // JSON array: ["Box", "Portão", "Cobertura", ...]
  estimatedValue Float?
  responsibleId  String?
  status         LeadStatus @default(NEW)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  lastContactAt  DateTime?
  notes          String?

  // Relações
  responsible Employee?    @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  opportunity Opportunity?
  activities  Activity[]
  history     CRMHistory[]
  company     Company      @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([source])
  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

// Opportunity (Oportunidade)
model Opportunity {
  id                String            @id @default(cuid())
  companyId         String
  leadId            String            @unique
  clientId          String?
  stage             OpportunityStage  @default(NEW_LEAD)
  value             Float
  probability       Int               @default(10)
  responsibleId     String?
  lastContactAt     DateTime?
  nextActionDate    DateTime?
  expectedCloseDate DateTime?
  status            OpportunityStatus @default(OPEN)
  lossReasonId      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  closedAt          DateTime?

  // Relações
  lead        Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client      Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  responsible Employee?         @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  lossReason  LossReason?       @relation(fields: [lossReasonId], references: [id], onDelete: SetNull)
  activities  Activity[]
  files       OpportunityFile[]
  history     CRMHistory[]

  @@index([companyId])
  @@index([stage])
  @@index([status])
  @@index([createdAt])
  @@map("opportunities")
}

// Activity (Atividade)
model Activity {
  id            String       @id @default(cuid())
  companyId     String
  leadId        String?
  opportunityId String?
  type          ActivityType
  title         String
  description   String?
  result        String?
  nextAction    String?
  attachmentUrl String?
  createdBy     String
  createdAt     DateTime     @default(now())
  scheduledFor  DateTime?
  completedAt   DateTime?

  // Relações
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  creator     Employee     @relation(fields: [createdBy], references: [id])

  @@index([companyId])
  @@index([type])
  @@index([leadId])
  @@index([opportunityId])
  @@index([createdAt])
  @@map("activities")
}

// Reminder (Lembretes)
model Reminder {
  id            String           @id @default(cuid())
  companyId     String
  leadId        String?
  opportunityId String?
  title         String
  description   String?
  dueDate       DateTime
  priority      ReminderPriority @default(NORMAL)
  isCompleted   Boolean          @default(false)
  assignedTo    String
  createdAt     DateTime         @default(now())
  completedAt   DateTime?

  // Relações
  assignee Employee @relation(fields: [assignedTo], references: [id])

  @@index([companyId])
  @@index([dueDate])
  @@index([priority])
  @@map("reminders")
}

// CRM History (Histórico de alterações)
model CRMHistory {
  id            String   @id @default(cuid())
  companyId     String
  leadId        String?
  opportunityId String?
  action        String
  description   String
  oldValue      String?
  newValue      String?
  userId        String
  createdAt     DateTime @default(now())

  // Relações
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([createdAt])
  @@map("crm_history")
}

// Files de Oportunidade
model OpportunityFile {
  id            String   @id @default(cuid())
  opportunityId String
  fileName      String
  fileUrl       String
  fileSize      Int
  mimeType      String
  fileType      String // "quote", "contract", "proposal", etc.
  uploadedBy    String
  createdAt     DateTime @default(now())

  // Relações
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@map("opportunity_files")
}

// Loss Reason (Motivos de perda)
model LossReason {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Relações
  opportunities Opportunity[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("loss_reasons")
}

// ═══════════════════════════════════════════════════════════════
// METAS E INDICADORES COMERCIAIS
// ═══════════════════════════════════════════════════════════════

model SalesGoal {
  id               String     @id @default(cuid())
  companyId        String
  employeeId       String? // Se null, é meta de equipe
  month            Int
  year             Int
  revenueTarget    Float
  quantityTarget   Int?
  conversionTarget Float? // Percentual
  status           GoalStatus @default(IN_PROGRESS)
  achievedRevenue  Float      @default(0)
  achievedQuantity Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // Relações
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([companyId, year, month, employeeId])
  @@index([companyId])
  @@index([employeeId])
  @@index([year, month])
  @@map("sales_goals")
}

model CommercialMetrics {
  id                  String   @id @default(cuid())
  companyId           String
  period              String // "2024-01" (YYYY-MM)
  leadsGenerated      Int      @default(0)
  leadsConverted      Int      @default(0)
  opportunitiesOpen   Int      @default(0)
  opportunitiesClosed Int      @default(0)
  averageTicket       Float    @default(0)
  totalRevenue        Float    @default(0)
  conversionRate      Float    @default(0) // Percentual
  averageClosingTime  Int      @default(0) // Dias
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relações

  @@unique([companyId, period])
  @@index([companyId])
  @@map("commercial_metrics")
}

model PostSale {
  id                String         @id @default(cuid())
  companyId         String
  projectId         String
  clientId          String
  status            PostSaleStatus @default(IN_PROGRESS)
  deliveryDate      DateTime?
  warrantyMonths    Int            @default(12)
  warrantyEndDate   DateTime?
  satisfactionScore Int?
  issues            String? // JSON array de problemas
  lastContactDate   DateTime?
  nextFollowDate    DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relações
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@unique([projectId])
  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@map("post_sales")
}

model LeadOrigin {
  id        String   @id @default(cuid())
  companyId String
  name      String
  icon      String? // Material Icon name
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relações

  @@unique([companyId, name])
  @@index([companyId])
  @@map("lead_origins")
}

// ═══════════════════════════════════════════════════════════════
// SEGURANÇA — SESSÕES E AUTENTICAÇÃO
// ═══════════════════════════════════════════════════════════════

model UserSession {
  id              String    @id @default(cuid())
  userId          String
  companyId       String
  deviceName      String?
  browser         String?
  operatingSystem String?
  ipAddress       String?
  lastActivityAt  DateTime  @default(now()) @updatedAt
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  // Relações

  @@index([userId])
  @@index([companyId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_sessions")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime  @default(now())

  // Relações

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  ipAddress String?
  browser   String?
  success   Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())

  // Relações (userId optional para failed attempts)

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([success])
  @@map("login_attempts")
}

// ═══════════════════════════════════════════════════════════════
// NOTIFICAÇÕES
// ═══════════════════════════════════════════════════════════════

model Notification {
  id        String               @id @default(cuid())
  userId    String
  companyId String
  title     String
  message   String
  type      NotificationType     @default(INFO)
  priority  NotificationPriority @default(NORMAL)
  category  NotificationCategory @default(SISTEMA)
  status    NotificationStatus   @default(UNREAD)
  actionUrl String?
  icon      String?
  readAt    DateTime?
  deletedAt DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  // Relações
  logs    NotificationLog[]
  company Company           @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([readAt])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationLog {
  id             String                @id @default(cuid())
  notificationId String
  channel        NotificationChannel   @default(INTERNAL)
  status         NotificationLogStatus @default(PENDING)
  error          String?
  sentAt         DateTime?
  attemptNumber  Int                   @default(1)
  nextRetryAt    DateTime?
  createdAt      DateTime              @default(now())

  // Relações
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
  @@map("notification_logs")
}

model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  companyId       String
  emailEnabled    Boolean  @default(true)
  pushEnabled     Boolean  @default(true)
  whatsappEnabled Boolean  @default(false)
  internalEnabled Boolean  @default(true)
  silentMode      Boolean  @default(false)
  silentStart     String? // HH:mm
  silentEnd       String? // HH:mm
  categories      String[] @default([]) // JSON array de categorias habilitadas
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações

  @@index([userId])
  @@index([companyId])
  @@map("notification_preferences")
}

model NotificationTemplate {
  id        String               @id @default(cuid())
  companyId String
  code      String
  name      String
  subject   String?
  template  String // HTML template com {{variables}}
  type      NotificationType     @default(INFO)
  category  NotificationCategory @default(SISTEMA)
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  // Relações

  @@unique([companyId, code])
  @@index([companyId])
  @@map("notification_templates")
}

model NotificationSettings {
  id              String   @id @default(cuid())
  companyId       String   @unique
  smtpHost        String?
  smtpPort        Int?
  smtpUser        String?
  smtpPassword    String?
