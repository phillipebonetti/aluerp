// AluERP — Schema Prisma Profissional
// Banco: PostgreSQL via Supabase
// Multi-tenant: cada empresa é um tenant isolado
// Versão: 3.0.0 (Fundação de Banco de Dados)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════
// CORE — INFRAESTRUTURA MULTIEMPRESA
// ═══════════════════════════════════════════════════════════════

// Empresa (Tenant)
model Company {
  id              String   @id @default(cuid())
  name            String
  cnpj            String?  @unique
  phone           String?
  email           String?
  logo            String?
  website         String?
  timezone        String   @default("America/Sao_Paulo")
  plan            Plan     @default(FREE)
  status          CompanyStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relações
  members         CompanyMember[]
  roles           Role[]
  permissions     Permission[]
  employees       Employee[]
  clients         Client[]
  suppliers       Supplier[]
  projects        Project[]
  quotes          Quote[]
  transactions    Transaction[]
  postSales       PostSale[]
  reportSchedules     ReportSchedule[]
  dashboardLayouts    DashboardLayout[]
  reportTemplates     ReportTemplate[]
  reportExports       ReportExport[]
  integrations    Integration[]
  webhooks        Webhook[]
  apiTokens       ApiToken[]
  whatsappMessages WhatsAppMessage[]
  emailMessages   EmailMessage[]
  calendarEvents  CalendarEvent[]
  storageFiles    StorageFile[]
  bankTransactions BankTransaction[]

  @@index([plan])
  @@index([status])
}

// Papéis RBAC
model Role {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  description     String?
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members         CompanyMember[]
  permissions     RolePermission[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

// Permissões
model Permission {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  description     String?
  resource        String   // ex: clients, projects, financeiro
  action          String   // ex: create, read, update, delete
  createdAt       DateTime @default(now())

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roles           RolePermission[]

  @@unique([companyId, resource, action])
  @@index([companyId])
  @@map("permissions")
}

// Junction para Role x Permission
model RolePermission {
  id              String   @id @default(cuid())
  roleId          String
  permissionId    String

  // Relações
  role            Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission      Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ═══════════════════════════════════════════════════════════════
// FUNCIONÁRIOS
// ═══════════════════════════════════════════════════════════════

model Employee {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  email           String?
  phone           String?
  role            EmployeeRole @default(OTHER)
  commissionRate  Decimal  @db.Decimal(5, 2) @default(0)
  status          EmployeeStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotes          Quote[]
  transactions    Transaction[]
  leadsResponsible Lead[]
  opportunitiesResponsible Opportunity[]
  activities      Activity[]
  reminders       Reminder[]
  responsibleStages WorkStage[]
  responsibleTasks WorkTask[]
  workTeams       WorkTeam[]
  salesGoals      SalesGoal[]

  @@index([companyId])
  @@index([status])
  @@index([email])
  @@index([companyId, status])
  @@map("employees")
}

// ═══════════════════════════════════════════════════════════════
// CLIENTES
// ═══════════════════════════════════════════════════════════════

model Client {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  type            ClientType @default(PERSON)
  documentType    DocumentType @default(CPF)
  document        String?
  email           String?
  phone           String?
  status          ClientStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts        ClientContact[]
  addresses       ClientAddress[]
  quotes          Quote[]
  projects        Project[]
  transactions    Transaction[]
  opportunities   Opportunity[]

  @@index([companyId])
  @@index([document])
  @@index([status])
  @@index([deletedAt])
  @@map("clients")
}

model ClientContact {
  id              String   @id @default(cuid())
  clientId        String
  name            String
  email           String?
  phone           String?
  role            String?
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  client          Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contacts")
}

model ClientAddress {
  id              String   @id @default(cuid())
  clientId        String
  street          String
  number          String?
  complement      String?
  neighborhood    String
  city            String
  state           String
  zipCode         String?
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  client          Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_addresses")
}

// ═══════════════════════════════════════════════════════════════
// FORNECEDORES
// ═══════════════════════════════════════════════════════════════

model Supplier {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  type            SupplierType @default(MATERIAL)
  documentType    DocumentType @default(CNPJ)
  document        String?
  email           String?
  phone           String?
  status          SupplierStatus @default(ACTIVE)
  notes           String?
  paymentTerms    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts        SupplierContact[]
  documents       SupplierDocument[]
  transactions    Transaction[]

  @@index([companyId])
  @@index([document])
  @@index([status])
  @@index([type])
  @@map("suppliers")
}

model SupplierContact {
  id              String   @id @default(cuid())
  supplierId      String
  name            String
  email           String?
  phone           String?
  role            String?
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())

  // Relações
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_contacts")
}

model SupplierDocument {
  id              String   @id @default(cuid())
  companyId       String
  supplierId      String
  type            DocumentFileType @default(OTHER)
  fileName        String
  fileSize        Int      // bytes
  mimeType        String?
  version         Int      @default(1)
  isLatest        Boolean  @default(true)
  description     String?
  tags            String?  // JSON array
  uploadedBy      String
  uploadedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relações
  company         Company @relation("SupplierDocumentCompany", fields: [companyId], references: [id], onDelete: Cascade)
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([supplierId])
  @@index([uploadedAt])
  @@map("supplier_documents")
}

// ═══════════════════════════════════════════════════════════════
// OBRAS / PROJETOS
// ═══════════════════════════════════════════════════════════════

model Project {
  id              String   @id @default(cuid())
  companyId       String
  clientId        String
  name            String
  description     String?
  address         String
  status          ProjectStatus @default(PLANNING)
  startDate       DateTime?
  endDate         DateTime?
  totalValue      Decimal? @db.Decimal(12, 2)
  costEstimated   Decimal? @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client          Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  photos          ProjectPhoto[]
  documents       ProjectDocument[]
  costs           ProjectCost[]
  serviceOrders   ServiceOrder[]
  quotes          Quote[]
  transactions    Transaction[]
  stages          WorkStage[]
  tasks           WorkTask[] @relation("WorkTasks")
  checklists      TaskChecklist[] @relation("TaskChecklists")
  measurements    WorkMeasurement[] @relation("WorkMeasurements")
  team            WorkTeam[] @relation("WorkTeam")
  occurrences     WorkOccurrence[] @relation("WorkOccurrences")
  diaries         WorkDiary[] @relation("WorkDiary")
  comments        WorkComment[] @relation("WorkComments")
  attachments     WorkAttachment[] @relation("WorkAttachments")
  postSale        PostSale?

  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@index([startDate])
  @@map("projects")
}

model ProjectPhoto {
  id              String   @id @default(cuid())
  companyId       String
  projectId       String
  fileName        String
  fileSize        Int      // bytes
  mimeType        String?  // image/jpeg, etc
  caption         String?
  orderIndex      Int      @default(0)
  uploadedBy      String
  uploadedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relações
  company         Company @relation("ProjectPhotoCompany", fields: [companyId], references: [id], onDelete: Cascade)
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@index([uploadedAt])
  @@map("project_photos")
}

model ProjectDocument {
  id              String   @id @default(cuid())
  companyId       String
  projectId       String
  type            DocumentFileType @default(OTHER)
  fileName        String
  fileSize        Int      // bytes
  mimeType        String?
  version         Int      @default(1)
  isLatest        Boolean  @default(true)
  description     String?
  tags            String?  // JSON array
  uploadedBy      String
  uploadedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relações
  company         Company @relation("ProjectDocumentCompany", fields: [companyId], references: [id], onDelete: Cascade)
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions        DocumentVersion[]

  @@unique([projectId, fileName, version])
  @@index([companyId])
  @@index([projectId])
  @@index([uploadedAt])
  @@map("project_documents")
}

// Versionamento de arquivos
model DocumentVersion {
  id              String   @id @default(cuid())
  documentId      String
  version         Int
  url             String
  fileName        String
  fileSize        Int      // bytes
  uploadedBy      String
  uploadedAt      DateTime @default(now())
  description     String?  // O que mudou nesta versão

  // Relações
  document        ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

model ProjectCost {
  id              String   @id @default(cuid())
  projectId       String
  description     String
  amount          Decimal  @db.Decimal(12, 2)
  category        String?
  createdAt       DateTime @default(now())

  // Relações
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_costs")
}

// ═══════════════════════════════════════════════════════════════
// GESTÃO DE OBRAS — ETAPAS, TAREFAS, CHECKLISTS
// ═══════════════════════════════════════════════════════════════

model WorkStage {
  id              String   @id @default(cuid())
  projectId       String
  companyId       String
  name            String
  position        Int      @default(0)
  status          WorkStageStatus @default(PENDING)
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  responsibleId   String?
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company         Company @relation("WorkStageCompany", fields: [companyId], references: [id], onDelete: Cascade)
  responsible     Employee? @relation(fields: [responsibleId], references: [id], onSetNull)
  tasks           WorkTask[]

  @@unique([projectId, position])
  @@index([projectId])
  @@index([companyId])
  @@index([status])
  @@map("work_stages")
}

model WorkTask {
  id              String   @id @default(cuid())
  projectId       String
  stageId         String
  companyId       String
  title           String
  description     String?
  status          WorkTaskStatus @default(TODO)
  priority        TaskPriority @default(NORMAL)
  responsibleId   String?
  dueDate         DateTime?
  startDate       DateTime?
  completedDate   DateTime?
  estimatedHours  Int?
  actualHours     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  project         Project @relation("WorkTasks", fields: [projectId], references: [id], onDelete: Cascade)
  stage           WorkStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  company         Company @relation("WorkTaskCompany", fields: [companyId], references: [id], onDelete: Cascade)
  responsible     Employee? @relation(fields: [responsibleId], references: [id], onSetNull)
  checklists      TaskChecklist[]
  comments        WorkComment[]
  attachments     WorkAttachment[]

  @@index([projectId])
  @@index([stageId])
  @@index([companyId])
  @@index([status])
  @@index([dueDate])
  @@map("work_tasks")
}

model TaskChecklist {
  id              String   @id @default(cuid())
  taskId          String
  projectId       String
  companyId       String
  title           String
  isCompleted     Boolean  @default(false)
  completedBy     String?
  completedAt     DateTime?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  task            WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project         Project @relation("TaskChecklists", fields: [projectId], references: [id], onDelete: Cascade)
  company         Company @relation("TaskChecklistCompany", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([projectId])
  @@index([companyId])
  @@map("task_checklists")
}

model WorkMeasurement {
  id              String   @id @default(cuid())
  projectId       String
  companyId       String
  environment     String?  // Cômodo, local
  height          Decimal? @db.Decimal(8, 2)
  width           Decimal? @db.Decimal(8, 2)
  depth           Decimal? @db.Decimal(8, 2)
  quantity        Int      @default(1)
  unit            String?  // m², m, px
  notes           String?
  photoUrl        String?
  sketchUrl       String?
  recordedBy      String
  recordedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  project         Project @relation("WorkMeasurements", fields: [projectId], references: [id], onDelete: Cascade)
  company         Company @relation("WorkMeasurementCompany", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([companyId])
  @@map("work_measurements")
}

model WorkTeam {
  id              String   @id @default(cuid())
  projectId       String
  employeeId      String
  companyId       String
  role            String?  // Chefe de Obra, Vidraceiro, etc.
  status          TeamMemberStatus @default(ASSIGNED)
  startDate       DateTime @default(now())
  endDate         DateTime?
  workedHours     Int      @default(0)
  addedBy         String
  addedAt         DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  project         Project @relation("WorkTeam", fields: [projectId], references: [id], onDelete: Cascade)
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  company         Company @relation("WorkTeamCompany", fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
  @@index([projectId])
  @@index([employeeId])
  @@index([companyId])
  @@map("work_teams")
}

model WorkOccurrence {
  id              String   @id @default(cuid())
  projectId       String
  companyId       String
  type            OccurrenceType @default(OTHER)
  title           String
  description     String?
  priority        OccurrencePriority @default(NORMAL)
  status          OccurrenceStatus @default(OPEN)
  reportedBy      String
  reportedAt      DateTime @default(now())
  resolvedBy      String?
  resolvedAt      DateTime?
  photoUrl        String?
  updatedAt       DateTime @updatedAt

  // Relações
  project         Project @relation("WorkOccurrences", fields: [projectId], references: [id], onDelete: Cascade)
  company         Company @relation("WorkOccurrenceCompany", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([companyId])
  @@index([status])
  @@index([priority])
  @@map("work_occurrences")
}

model WorkDiary {
  id              String   @id @default(cuid())
  projectId       String
  companyId       String
  date            DateTime @default(now())
  author          String
  description     String
  weather         String?  // Ensolarado, Chuvoso, etc.
  weather_temp    Int?     // Temperatura em Celsius
  teamPresent     String?  // JSON array de IDs
  materialsUsed   String?  // JSON array
  photoUrl        String?
  videoUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  project         Project @relation("WorkDiary", fields: [projectId], references: [id], onDelete: Cascade)
  company         Company @relation("WorkDiaryCompany", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([companyId])
  @@index([date])
  @@map("work_diaries")
}

model WorkComment {
  id              String   @id @default(cuid())
  taskId          String?
  projectId       String
  companyId       String
  author          String
  content         String
  mentions        String?  // JSON array de user IDs
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  task            WorkTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project         Project @relation("WorkComments", fields: [projectId], references: [id], onDelete: Cascade)
  company         Company @relation("WorkCommentCompany", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([projectId])
  @@index([companyId])
  @@map("work_comments")
}

model WorkAttachment {
  id              String   @id @default(cuid())
  taskId          String?
  projectId       String
  companyId       String
  fileName        String
  fileSize        Int
  mimeType        String?
  fileUrl         String
  uploadedBy      String
  uploadedAt      DateTime @default(now())
  description     String?

  // Relações
  task            WorkTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project         Project @relation("WorkAttachments", fields: [projectId], references: [id], onDelete: Cascade)
  company         Company @relation("WorkAttachmentCompany", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([projectId])
  @@index([companyId])
  @@map("work_attachments")
}

// ═══════════════════════════════════════════════════════════════
// ORÇAMENTOS / COTAÇÕES
// ═══════════════════════════════════════════════════════════════
// ORÇAMENTOS / COTAÇÕES
// ═══════════════════════════════════════��══════════��════════════

model Quote {
  id              String   @id @default(cuid())
  companyId       String
  clientId        String
  projectId       String?
  salespersonId   String?
  number          String
  status          QuoteStatus @default(DRAFT)
  totalValue      Decimal  @db.Decimal(12, 2)
  commissionRateApplied Decimal? @db.Decimal(5, 2)
  validUntil      DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  sentAt          DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  deletedAt       DateTime?

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client          Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  salesperson     Employee? @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
  items           QuoteItem[]
  versions        QuoteVersion[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([clientId])
  @@index([projectId])
  @@index([salespersonId])
  @@index([status])
  @@index([createdAt])
  @@index([companyId, projectId])
  @@index([companyId, clientId])
  @@index([companyId, salespersonId])
  @@map("quotes")
}

model QuoteItem {
  id              String   @id @default(cuid())
  quoteId         String
  description     String
  quantity        Decimal  @db.Decimal(10, 3)
  unit            String   @default("un")
  unitPrice       Decimal  @db.Decimal(12, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)
  discount        Decimal? @db.Decimal(12, 2) @default(0)
  order           Int

  // Relações
  quote           Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_items")
}

model QuoteVersion {
  id              String   @id @default(cuid())
  quoteId         String
  versionNumber   Int
  status          QuoteStatus
  totalValue      Decimal  @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime @default(now())

  // Relações
  quote           Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, versionNumber])
  @@index([quoteId])
  @@map("quote_versions")
}

// ═════════════════════════════════════════════════════════��═════
// ORDENS DE SERVIÇO
// ══════════════════════════════════════════════════════════════���

model ServiceOrder {
  id              String   @id @default(cuid())
  companyId       String
  projectId       String
  number          String
  status          ServiceOrderStatus @default(DRAFT)
  scheduledDate   DateTime?
  startDate       DateTime?
  endDate         DateTime?
  description     String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project         Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([companyId, number])
  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@map("service_orders")
}

// ═══════════════════════════════════════════════════════════════
// FINANCEIRO
// ═══════════════════════════════════════════════════════════════

model BankAccount {
  id              String   @id @default(cuid())
  companyId       String
  bankName        String
  accountNumber   String
  accountType     String
  balance         Decimal  @db.Decimal(14, 2) @default(0)
  status          BankAccountStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions    Transaction[]

  @@index([companyId])
  @@map("bank_accounts")
}

model CostCenter {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  description     String?
  status          CostCenterStatus @default(ACTIVE)
  createdAt       DateTime @default(now())

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions    Transaction[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("cost_centers")
}

model ExpenseCategory {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions    Transaction[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("expense_categories")
}

model IncomeCategory {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions    Transaction[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("income_categories")
}

model Transaction {
  id              String   @id @default(cuid())
  companyId       String
  type            TransactionType
  category        String?
  amount          Decimal  @db.Decimal(14, 2)
  description     String
  status          TransactionStatus @default(PENDING)
  paymentMethod   PaymentMethod
  dueDate         DateTime?
  paymentDate     DateTime?
  notes           String?
  supplierId      String?
  clientId        String?
  projectId       String?
  salespersonId   String?
  bankAccountId   String?
  costCenterId    String?
  expenseCategoryId String?
  incomeCategoryId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  client          Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  salesperson     Employee? @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
  bankAccount     BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  costCenter      CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  expenseCategory ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)
  incomeCategory  IncomeCategory? @relation(fields: [incomeCategoryId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([type])
  @@index([status])
  @@index([dueDate])
  @@index([paymentDate])
  @@index([clientId])
  @@index([projectId])
  @@index([salespersonId])
  @@index([companyId, status, dueDate])
  @@index([companyId, type, paymentDate])
  @@index([companyId, clientId])
  @@index([companyId, projectId])
  @@index([companyId, salespersonId])
  @@map("transactions")
}

