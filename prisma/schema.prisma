// ═══════════════════════════════════════════════════════════════
// CRM — GESTÃO DE RELACIONAMENTO COM CLIENTES
// ═════════���═══════════════════════════════════════════════��═════

// Lead (Prospect)
model Lead {
  id                String   @id @default(cuid())
  companyId         String
  name              String
  email             String?
  phone             String?
  whatsapp          String?
  cpf               String?
  cnpj              String?
  city              String?
  state             String?
  zipCode           String?
  address           String?
  source            LeadSource @default(OUTRO)
  interests         String?   // JSON array: ["Box", "Portão", "Cobertura", ...]
  estimatedValue    Float?
  responsibleId     String?
  status            LeadStatus @default(NEW)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastContactAt     DateTime?
  notes             String?

  // Relações
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  responsible       Employee? @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  opportunity       Opportunity?
  activities        Activity[]
  history           CRMHistory[]

  @@index([companyId])
  @@index([source])
  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

// Opportunity (Oportunidade)
model Opportunity {
  id                String   @id @default(cuid())
  companyId         String
  leadId            String   @unique
  clientId          String?
  stage             OpportunityStage @default(NEW_LEAD)
  value             Float
  probability       Int      @default(10)
  responsibleId     String?
  lastContactAt     DateTime?
  nextActionDate    DateTime?
  expectedCloseDate DateTime?
  status            OpportunityStatus @default(OPEN)
  lossReasonId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  closedAt          DateTime?

  // Relações
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead              Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client            Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  responsible       Employee? @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  lossReason        LossReason? @relation(fields: [lossReasonId], references: [id], onDelete: SetNull)
  activities        Activity[]
  files             OpportunityFile[]
  history           CRMHistory[]

  @@index([companyId])
  @@index([stage])
  @@index([status])
  @@index([createdAt])
  @@map("opportunities")
}

// Activity (Atividade)
model Activity {
  id                String   @id @default(cuid())
  companyId         String
  leadId            String?
  opportunityId     String?
  type              ActivityType
  title             String
  description       String?
  result            String?
  nextAction        String?
  attachmentUrl     String?
  createdBy         String
  createdAt         DateTime @default(now())
  scheduledFor      DateTime?
  completedAt       DateTime?

  // Relações
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead              Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity       Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  creator           Employee @relation(fields: [createdBy], references: [id])

  @@index([companyId])
  @@index([type])
  @@index([leadId])
  @@index([opportunityId])
  @@index([createdAt])
  @@map("activities")
}

// Reminder (Lembretes)
model Reminder {
  id                String   @id @default(cuid())
  companyId         String
  leadId            String?
  opportunityId     String?
  title             String
  description       String?
  dueDate           DateTime
  priority          ReminderPriority @default(NORMAL)
  isCompleted       Boolean  @default(false)
  assignedTo        String
  createdAt         DateTime @default(now())
  completedAt       DateTime?

  // Relações
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignee          Employee @relation(fields: [assignedTo], references: [id])

  @@index([companyId])
  @@index([dueDate])
  @@index([priority])
  @@map("reminders")
}

// CRM History (Histórico de alterações)
model CRMHistory {
  id                String   @id @default(cuid())
  companyId         String
  leadId            String?
  opportunityId     String?
  action            String
  description       String
  oldValue          String?
  newValue          String?
  userId            String
  createdAt         DateTime @default(now())

  // Relações
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead              Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity       Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user              User @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([createdAt])
  @@map("crm_history")
}

// Files de Oportunidade
model OpportunityFile {
  id                String   @id @default(cuid())
  opportunityId     String
  fileName          String
  fileUrl           String
  fileSize          Int
  mimeType          String
  fileType          String    // "quote", "contract", "proposal", etc.
  uploadedBy        String
  createdAt         DateTime @default(now())

  // Relações
  opportunity       Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@map("opportunity_files")
}

// Loss Reason (Motivos de perda)
model LossReason {
  id                String   @id @default(cuid())
  companyId         String
  name              String
  description       String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  // Relações
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunities     Opportunity[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("loss_reasons")
}

