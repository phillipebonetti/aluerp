// Configurações da Empresa
model CompanySetting {
  id              String   @id @default(cuid())
  companyId       String   @unique
  
  // Dados da empresa
  logo            String?  // URL ou base64
  razaoSocial     String?
  cnpj            String?
  
  // Contato
  email           String?
  whatsapp        String?
  
  // Financeiro
  comissaoPercentual Float? @default(5.0)
  impostoPercentual Float? @default(15.0)
  
  // Horários e metas
